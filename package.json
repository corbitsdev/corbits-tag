{
  "name": "corbits-tag",
  "version": "0.1.0",
  "description": "Chat-tag ingress you mount onto an Interchange hub",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": "./src/core/index.ts",
    "./slack": "./src/slack/index.ts",
    "./interchange": "./src/interchange/index.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text ./src"
  },
  "dependencies": {
    "@chat-adapter/slack": "^4.34.0",
    "@intx/db": "0.2.2",
    "arktype": "^2.2.3",
    "chat": "^4.34.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "license": "LGPL-2.1-or-later",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-tag.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-tag#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-tag/issues"
  },
  "keywords": [
    "chat",
    "tag",
    "ingress",
    "interchange",
    "slack",
    "hono",
    "chat-sdk",
    "principal",
    "auth"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ]
}
