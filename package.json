  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-tag.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-tag#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-tag/issues"
  }
}
